# Personal scan output — contains usernames, account names, timestamps, hits.
# Never publish. Users' own reports stay on their own machines.
findings/
*.report.txt
scan-*.txt
scan-*.json

# The website self-check is deployed separately and is a different work stream;
# its NOTES.md also carries infrastructure detail that must not be published.
web/

# Python caches and build junk
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.DS_Store

# The single-file build is a release artifact, regenerated by build/bundle.py.
# Keep it out of source control so the source is the source of truth.
zero-breach.py
/dist/zero-breach.py


# Internal development/process docs — kept locally, not published.
HANDOVER.md
DESIGN.md
SPEC-scanner.md
REVIEW-*.md
RELEASE-CANDIDATE-*.md

